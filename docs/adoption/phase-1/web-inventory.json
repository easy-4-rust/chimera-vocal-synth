    "vite.config.ts"
  ],
  "tests_and_tools": [
    "tests/creature-abi.test.ts",
    "tests/expression.test.ts",
    "tests/harness.ts",
    "tests/live-control.test.ts",
    "tests/petting.test.ts",
    "tests/singing-live.test.ts",
    "tests/tele.test.ts",
    "tests/transport.test.ts",
    "tests/wasm-engine.test.ts",
    "tests/words.test.ts",
    "tools/asr/sentences.tsv",
    "tools/asr/setup.sh",
    "tools/asr/speech_wer.py",
    "tools/bench-wasm.ts",
    "tools/build-dict.ts",
    "tools/e2e.ts",
    "tools/fetch-csd.sh",
    "tools/gen-ipa-nfc.ts",
    "tools/gen-syrinx-table.ts",
