{
  "baseline": "5ab44de236b0eb384ec4d81ec216e0d0928a9f7a",
  "package": {
    "name": "chimera-voice",
    "private": true,
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
      "dev": "bun run wasm && vite --host 127.0.0.1",
      "build": "bun run wasm && tsc --noEmit && vite build",
      "preview": "vite preview --host 127.0.0.1",
      "test": "bun run wasm && cargo test --workspace && bun test tests",
      "typecheck": "tsc --noEmit",
      "lint:layout": "bun run wasm && bun tools/layout-lint.ts",
      "wasm": "cargo build -p chimera-wasm --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/chimera_wasm.wasm src/wasm/chimera.wasm"
    },
    "dependencies": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "three": "0.186.1",
      "zustand": "5.0.16"
    },
    "devDependencies": {
      "@types/bun": "1.4.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/three": "0.186.0",
      "@vitejs/plugin-react": "6.2.1",
      "playwright-core": "1.64.1",
      "typescript": "7.0.2",
      "vite": "8.3.6"
    }
  },
  "lockfiles": [
    "bun.lock"
  ],
  "build_inputs": [
    "index.html",
    "src/wasm/chimera.ts",
    "src/wasm/engine.ts",
    "src/wasm/types.ts",
    "src/wasm/wasm.d.ts",
    "src/wasm/wire.ts",
    "src/worklet/processor.ts",
    "src/worklet/protocol.ts",
    "tsconfig.json",
